{
  "name": "steepy-formula",
  "version": "1.0.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Land governed project knowledge in a canonical Stable Knowledge Graph, route work by surface, and keep it coherent with graph validation.",
  "keywords": [
    "context-engineering",
    "workflows",
    "skills",
    "spec-driven-development",
    "code-review",
    "subagents",
    "autonomous-loops",
    "project-knowledge",
    "documentation-drift",
    "agents-md",
    "model-selection",
    "knowledge-graph"
  ],
  "author": {
    "name": "steepy-it",
    "email": "info@steepy.it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steepy-it/steepy-formula.git"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "neo4j-driver": "6.2.0"
  },
  "main": "./adapters/opencode/steepy-formula.js",
  "bin": {
    "steepy-formula": "scripts/formula/npm-cli.mjs"
  },
  "exports": {
    ".": "./adapters/opencode/steepy-formula.js",
    "./adapters/dsh": "./adapters/dsh/steepy-formula.js"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./adapters/pi"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    "adapters/",
    "assets/",
    "bin/",
    "docs/",
    "scripts/",
    "skills/",
    "templates/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PRIVACY.md",
    "LICENSE",
    "NOTICE",
    "RELEASE.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
